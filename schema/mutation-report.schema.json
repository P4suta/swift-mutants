{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Swift mutation measurement",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "results", "summary", "score"],
  "properties": {
    "schemaVersion": { "const": 3 },
    "score": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "results": { "type": "array", "items": { "$ref": "#/$defs/result" } },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "mutation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "rule", "byteRange", "sourceDigest", "original", "replacement", "line", "column"],
      "properties": {
        "id": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "path": { "type": "string", "minLength": 1 },
        "rule": { "type": "string", "minLength": 1 },
        "sourceDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "original": { "type": "string" },
        "replacement": { "type": "string" },
        "line": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 1 },
        "byteRange": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end"],
          "properties": {
            "start": { "type": "integer", "minimum": 0 },
            "end": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mutation", "outcome", "durationMilliseconds"],
      "properties": {
        "mutation": { "$ref": "#/$defs/mutation" },
        "outcome": { "enum": ["killed", "survived", "rejected", "timedOut", "errored"] },
        "durationMilliseconds": { "type": "integer", "minimum": 0 },
        "diagnostic": { "type": "string" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["killed", "survived", "rejected", "timedOut", "errored", "total"],
      "properties": {
        "killed": { "type": "integer", "minimum": 0 },
        "survived": { "type": "integer", "minimum": 0 },
        "rejected": { "type": "integer", "minimum": 0 },
        "timedOut": { "type": "integer", "minimum": 0 },
        "errored": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
