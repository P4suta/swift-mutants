extends: default
# Any scratch directory a build writes, not only the default one. `.build-release` is
# written by the release gate and holds a compiler's own YAML - debug relocation maps -
# which is not this repository's YAML and does not follow its rules. The same gap put
# somebody else's Swift in front of a source gate earlier.
ignore: |
  .build*/
  Fixtures/
  vendor/
rules:
  line-length:
    max: 120
  document-start: disable
  truthy:
    check-keys: false
